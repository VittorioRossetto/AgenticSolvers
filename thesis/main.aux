\@writefile{lot}{\contentsline {table}{\numberline {6.1}{\ignorespaces Parallel-solver evaluation results for all LLMs on unprocessed (plain) MiniZinc scripts. The column ``Model'' identifies each tested LLM by its API name. ``Total Score'' corresponds to the Parallel Score metric as defined in \Cref  {tab:combinedAllLLM}. ``Instances Covered'' reports the number of instances for which a valid response was obtained, i.e., those whose token count did not exceed the rate limits reported in \Cref  {tab:rate_limits_groq} and \Cref  {tab:rate_limits_gemini}. ``Average Score'' is computed as $\nicefrac  {\text  {Total Score}}{\text  {Instances Covered}}$ and reflects solver selection quality over the evaluated instances.}}{61}{table.caption.45}\protected@file@percent }
\newlabel{tab:allLLM3}{{6.1}{61}{Parallel-solver evaluation results for all LLMs on unprocessed (plain) MiniZinc scripts. The column ``Model'' identifies each tested LLM by its API name. ``Total Score'' corresponds to the Parallel Score metric as defined in \Cref {tab:combinedAllLLM}. ``Instances Covered'' reports the number of instances for which a valid response was obtained, i.e., those whose token count did not exceed the rate limits reported in \Cref {tab:rate_limits_groq} and \Cref {tab:rate_limits_gemini}. ``Average Score'' is computed as $\nicefrac {\text {Total Score}}{\text {Instances Covered}}$ and reflects solver selection quality over the evaluated instances}{table.caption.45}{}}
\newlabel{tab:allLLM3@cref}{{[table][1][6]6.1}{[1][61][]61}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6.2}{\ignorespaces Single-solver evaluation results for all LLMs on unprocessed (plain) MiniZinc scripts. ``Total Score'' corresponds to the Single Score metric as defined in \Cref  {tab:combinedAllLLM}. The remaining columns are computed as described in \Cref  {tab:allLLM3}.}}{62}{table.caption.46}\protected@file@percent }
\newlabel{tab:allLLM1}{{6.2}{62}{Single-solver evaluation results for all LLMs on unprocessed (plain) MiniZinc scripts. ``Total Score'' corresponds to the Single Score metric as defined in \Cref {tab:combinedAllLLM}. The remaining columns are computed as described in \Cref {tab:allLLM3}}{table.caption.46}{}}
