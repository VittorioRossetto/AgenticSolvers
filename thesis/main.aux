\@writefile{lot}{\contentsline {table}{\numberline {6.3}{\ignorespaces Closed-gap evaluation results for all LLMs on unprocessed (plain) MiniZinc scripts. ``Instances Covered'' is defined as in \Cref  {tab:allLLM3}. ``AS'' denotes the Aggregate Score, equivalent to the Single Score in \Cref  {tab:combinedAllLLM}. ``SBS'' reports the total score accumulated by the single best solver (\texttt  {or-tools\_cp-sat-free}) across all instances; ``VBS'' reports the score of the hypothetical Virtual Best Solver, which achieves the maximum attainable score on every instance. ``Closed Gap'' is computed as defined in \Cref  {tab:combinedAllLLM}.}}{62}{table.caption.47}\protected@file@percent }
\newlabel{tab:allLLMcg}{{6.3}{62}{Closed-gap evaluation results for all LLMs on unprocessed (plain) MiniZinc scripts. ``Instances Covered'' is defined as in \Cref {tab:allLLM3}. ``AS'' denotes the Aggregate Score, equivalent to the Single Score in \Cref {tab:combinedAllLLM}. ``SBS'' reports the total score accumulated by the single best solver (\texttt {or-tools\_cp-sat-free}) across all instances; ``VBS'' reports the score of the hypothetical Virtual Best Solver, which achieves the maximum attainable score on every instance. ``Closed Gap'' is computed as defined in \Cref {tab:combinedAllLLM}}{table.caption.47}{}}
